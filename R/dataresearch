library(dplyr)
library(lubridate)

games <- read.csv("Games.csv")
teamStatisticsExtended <- read.csv("TeamStatisticsExtended.csv")
teamHistories <- read.csv("TeamHistories.csv")



# ---- Basic cleaning -----------------------------------------------------

# games: parse datetime, derive a season label (NBA season spans Oct-Jun,
# so games from Jan-Sep "belong" to the season that started the previous fall)
games <- games %>%
  mutate(
    gameDateTimeEst = as_datetime(gameDateTimeEst),
    season = if_else(month(gameDateTimeEst) >= 10,
                     year(gameDateTimeEst),
                     year(gameDateTimeEst) - 1),
    winner = as.character(winner)
  ) %>%
  filter(gameType %in% c("Regular Season")) # drop preseason/playoffs for the base model;
# keep a separate playoffs table if you want
# to model playoff-specific performance later

# teamStatisticsExtended: same season derivation, drop rows with mostly-NA advanced stats
# (common in very early seasons before some tracking stats existed)
teamStatisticsExtended <- teamStatisticsExtended %>%
  mutate(
    gameDateTimeEst = as_datetime(gameDateTimeEst),
    season = if_else(month(gameDateTimeEst) >= 10,
                     year(gameDateTimeEst),
                     year(gameDateTimeEst) - 1)
  ) %>%
  filter(gameType == "Regular Season")

# teamHistories: keep the most recent franchise name/city per teamId for display,
# but keep the full history table too since older seasons should show the
# period-correct name (e.g. Seattle SuperSonics, not OKC Thunder, pre-2008)
teamHistories <- teamHistories %>%
  mutate(seasonActiveTill = if_else(is.na(seasonActiveTill), 2100L, seasonActiveTill))

team_current_name <- teamHistories %>%
  group_by(teamId) %>%
  slice_max(seasonActiveTill, n = 1) %>%
  ungroup() %>%
  select(teamId, currentCity = teamCity, currentName = teamName, teamAbbrev)

# helper: look up the period-correct franchise name for a given teamId + season
get_team_name_for_season <- function(id, yr) {
  teamHistories %>%
    filter(teamId == id, seasonFounded <= yr, seasonActiveTill >= yr) %>%
    slice(1) %>%
    mutate(full_name = paste(teamCity, teamName)) %>%
    pull(full_name)
}

dir.create("data/processed", showWarnings = FALSE, recursive = TRUE)
write_csv(games, "data/processed/games_clean.csv")
write_csv(teamStatisticsExtended, "data/processed/team_stats_clean.csv")
write_csv(team_current_name, "data/processed/team_current_name.csv")
saveRDS(teamHistories, "data/processed/team_histories.rds") # keep full history for the name lookup helper
